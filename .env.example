# Claude credentials (or run `ant auth login`). Without them the app runs rules-only.
ANTHROPIC_API_KEY=
# Optional: force AI on/off ("true"/"false"). Default: on when a key is set.
AI_ENABLED=
CLAUDE_MODEL=claude-opus-5-5
PORT=3000
DB_PATH=data/offer-lens.db
# Salt for hashing reporter IPs. Set a random value in production.
REPORT_SALT=change-me
# Set to 1 when running behind a reverse proxy (Render, Railway, nginx).
TRUST_PROXY=
LOOKUP_TIMEOUT_MS=4000
AI_RATE_LIMIT=20

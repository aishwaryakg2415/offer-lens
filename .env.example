# AI review and screenshot reading. Set ONE of these; with neither, the app runs rules-only.
# Free option: Groq. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Paid option: Claude. Get a key at https://platform.claude.com (or run `ant auth login`).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Optional: "claude" or "groq" to choose when both keys are set (default: Claude first).
AI_PROVIDER=
# Optional: "false" turns AI off entirely.
AI_ENABLED=
PORT=3000
DB_PATH=data/offer-lens.db
# Salt for hashing reporter IPs. Set a random value in production.
REPORT_SALT=change-me
# Set to 1 when running behind a reverse proxy (Render, Railway, nginx).
TRUST_PROXY=
LOOKUP_TIMEOUT_MS=4000
AI_RATE_LIMIT=20
